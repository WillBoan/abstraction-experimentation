rung {
    first_source_color(pattern: Grid, seeds: Grid) -> Color = read_color_at_coord(pattern, nth(content_coords(seeds, 0), 0)) if lt(0, length(content_coords(seeds, 0))) else 0
}

rung {
    second_source_color(pattern: Grid, seeds: Grid) -> Color = read_color_at_coord(pattern, nth(content_coords(seeds, 0), 1)) if lt(1, length(content_coords(seeds, 0))) else 0
}

rung {
    first_target_color(seeds: Grid) -> Color = nth_or_default(content_colors(seeds, 0), 0, 0)
}

rung {
    second_target_color(seeds: Grid) -> Color = nth_or_default(content_colors(seeds, 0), 1, 0)
}

rung {
    source_mask(pattern: Grid, seeds: Grid) -> Mask = mask_union(mask_by_color(pattern, first_source_color(pattern, seeds)), mask_by_color(pattern, second_source_color(pattern, seeds)))
}

