ladder cfb2ce5a-5-lowered-full

# Full partially-lowered v5 for cfb2ce5a. Lowers the 4 tractable percepts into rungs; keeps
# relative_tile / write_relative_tile ATOMIC (addressing arithmetic stays out of the pool).
# Seed-recolor rungs vary (pattern,seeds) over 3 tile directions -> genuine parameterization.

config {
    budget.depth_limit: 4
    budget.max_pool: 8000
    search_engine.constant_sources: ['finite-enumerate-scalars']
}

floor cfb2ce5a-lowered-full-L0 {
    use flip_h: (Grid) -> Grid
    use flip_v: (Grid) -> Grid
    use map_color: (Grid, Color, Color) -> Grid
    use if: (Bool, a, a) -> a
    use filled_squares: (Grid, Color) -> List[Rect]
    use head: (List[a]) -> a
    use crop_rect: (Grid, Rect) -> Grid
    use mask_by_color: (Grid, Color) -> Mask
    use mask_union: (Mask, Mask) -> Mask
    use mask_complement: (Mask) -> Mask
    use paint_through_mask: (Grid, Mask, Color) -> Grid
    use content_colors: (Grid, Color) -> List[Color]
    use nth_or_default: (List[a], Int, a) -> a
    use content_coords: (Grid, Color) -> List[Coord]
    use nth: (List[a], Int) -> a
    use length: (List[a]) -> Int
    use lt: (Int, Int) -> Bool
    use read_color_at_coord: (Grid, Coord) -> Color
    use relative_tile: (Grid, Int, Int) -> Grid
    use write_relative_tile: (Grid, Grid, Grid, Int, Int) -> Grid
}

