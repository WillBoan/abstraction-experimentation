ladder cfb2ce5a-5-lowered-lattice

# v5 fine tile-lattice core, lowered onto the addressing floor. Non-Grid rungs (source_rect,
# tile_size, tile_origin) are demoed via GRID WRAPPERS. Authored at natural mixed depths
# (d2-d4) under the certificate-profile reframe (skip-freeness is now a warning).

config {
    budget.depth_limit: 4
    budget.max_arity: 3
    budget.max_pool: 4000
    search_engine.constant_sources: ['finite-enumerate-scalars']
    learn.learn_engine.proposer: 'StitchProposer'
}

floor cfb2ce5a-lowered-L0 {
    use filled_squares: (Grid, Color) -> List[Rect]
    use head: (List[a]) -> a
    use crop_rect: (Grid, Rect) -> Grid
    use rect: (Coord, Offset) -> Rect
    use rect_origin: (Rect) -> Coord
    use rect_extent: (Rect) -> Offset
    use offset: (Int, Int) -> Offset
    use offset_row: (Offset) -> Int
    use coord_add: (Coord, Offset) -> Coord
    use offset_scale: (Offset, Int) -> Offset
    use blank: (Offset, Color) -> Grid
}

