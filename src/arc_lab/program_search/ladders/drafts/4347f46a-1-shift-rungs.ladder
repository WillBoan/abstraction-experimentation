ladder 4347f46a-1-shift-rungs

# ``4347f46a-1-shift-rungs``: the hollow-rectangles competence with the four neighbour shifts as
# SEPARATE sibling rungs. RECONSTRUCTED (2026-07-26) from the recorded design -- the generator was
# patched forward in place before this variant was saved.
#
# **Kept because its probe verdict is the finding, and it is two findings at once:**
#
# 1. **Sibling rungs are skippable by construction.** `shift_down`/`shift_up`/`shift_right`/
#    `shift_left` are four INDEPENDENT depth-2/3 compositions over the floor -- none consumes
#    another -- so each is reachable from L_0 directly and every one probed an explicit SKIP PATH
#    (`shift_up` via `translate(input, offset_neg(offset(1, 0)))`, and so on). Parallel branches at
#    the same depth from the floor cannot certify against each other.
# 2. **Each extra abstraction taxes every later round.** With four near-duplicate rungs in the
#    library, rungs 5+ censored outright at the default guard.
#
# The replacement folded all four into ONE parameterized rung `neighbor_filled(g, d)`
# (`4347f46a-hollow-rects.ladder`), which in turn exposed the demo-affordability law.

config {
    budget.depth_limit: 3
    budget.max_pool: 4000
    search_engine.constant_sources: ['finite-enumerate-scalars']
    learn.learn_engine.proposer: 'StitchProposer'
}

floor 4347f46a-shift-L0 {
    use translate:          (Grid, Offset) -> Grid
    use offset:             (Int, Int) -> Offset
    use offset_neg:         (Offset) -> Offset
    use mask_by_color:      (Grid, Color) -> Mask
    use mask_complement:    (Mask) -> Mask
    use mask_intersect:     (Mask, Mask) -> Mask
    use paint_through_mask: (Grid, Mask, Color) -> Grid
}

rung {
