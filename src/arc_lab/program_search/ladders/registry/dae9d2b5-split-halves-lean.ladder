ladder dae9d2b5-split-halves-lean

# ``dae9d2b5-split-halves-lean``: the merge-two-halves competence of the real ARC task ``dae9d2b5``
# (arc1-train), laddered over a GRID-valued half-split floor. The COARSE member of the granularity
# pair with ``dae9d2b5-split-recolor`` -- same floor, same task, same competence, two rungs instead
# of four. Within a cohort raw cancels, so cost vs cut density is fully measured here: this pair is
# the granularity curve, which is the cheapest scientific value in the set (RQ2).
#
# The competence: an ``h x 2w`` grid carries colour 4 on its left half and 3 on its right; the
# answer is the ``h x w`` grid holding 6 wherever EITHER half is non-blank. Verified against
# arc1-train ground truth (all 5 train + both held-out tests) before authoring
# (``test_real_arc_anchoring.py``).
#
# The spine: the two halves. The top recolours each and merges them, in the DISTRIBUTED form --
# which is the same top the fine member reaches through its two recolour rungs, so the two members
# state literally the same competence and differ only in where the cuts fall.
#
# **What the coarser cut costs, stated before running.** Folding the recolours into the top makes
# the top d3 where the fine member's is d2, so ``L_2`` runs one round deeper. Cost is
# ``(primitives x constants)^depth``: one deeper level should dominate this member's total, and the
# fine member should be CHEAPER despite having twice the rungs. That is the prediction the pair
# exists to test, and it is the opposite of the naive reading (more rungs = more search).
#
# **The floor.** ``split_h: (Grid) -> List[Grid]`` gives the halves in the type its consumers want,
# so a half is d2 rather than the d3 the region tier costs
# (``crop_rect(g, head(halves_h(g)))`` -- two of whose three levels are pure plumbing). ``overlay``
# is the grid-level OR, so merging needs no Mask rung and every rung stays Grid-valued, which keeps
# every demonstration a full solution. See ``dae9d2b5-split-recolor``'s header for the full
# derivation and for what the predecessor ``dae9d2b5-halves-union`` paid without it (21,149,854
# considered on a rung whose optimally-pruned cost is 4).
#
# **Withheld primitives:** nothing was removed to make the task hard -- the floor is the minimum the
# top needs, and ``d_raw`` 4 against a derived top budget of 3 falls out of that. What IS withheld
# is any single-step half-merger (none exists in the substrate, and none was added) and the
# region-tier route (``halves_h`` / ``crop_rect`` / ``head``), which only re-buys plumbing depth.
#
# **Skip-audit, by hand, before any probe** (LADDER-PROCESS section 5): both rungs are d2 and their
# only consumer is the d3 top, so inlining either costs d4 against ``L_1``'s budget of 2 -- out of
# reach twice over. ``map_color`` distributing over ``overlay`` (the law that convicted
# ``dae9d2b5-2-merge-rung``'s merge rung) cannot bite here: there is no merge rung, and the top is
# already stated in the distributed form that law produces.

# **The budget is shared with ``dae9d2b5-split-recolor-lean`` on purpose** -- identical floor,
# `max_pool` (30), `max_arity` and `considered_limit`, so the only thing that differs across the
# pair is where the cuts fall (and the depth schedule that follows). That is what makes the cost
# comparison licensed rather than confounded.
#
# **Why a `lean` pair exists at all.** At `max_pool` 150 the coarse member could not be certified:
# its top is d3, so its skip test must reach d4, and every skip search CENSORED at the 2M budget
# where the fine member's exhausted at ~300k. Rather than escalate the budget, the pool was
# calibrated: `dae9d2b5-split-recolor-lean` reproduces its parent's verdict profile EXACTLY
# (4/4 tractable, no skip paths, health 1.0, all four rungs recovered, same mints) at
# **25.4x less** total spend and 1m51s instead of ~45min. This is that calibration applied to the
# coarse arm, so the granularity curve is measured at a budget where BOTH members conclude.

# **Stop limit (2026-07-27).** `solution_limit: 1` at `immediate` mode: a cell stops at its first
# solution instead of enumerating the rest of its budget. Measured 19.5x-63x on these cells, and
# `first_solution_index` is IDENTICAL either way -- so cost-to-first, the currency every rung-value
# and RQ1 comparison is read in, is exactly preserved. Skip searches are unaffected: they do not
# solve, so they exhaust regardless, which is what `no_skip_paths` requires. Validated as a PAIR
# with the per-level pool against `dae9d2b5-split-recolor`'s certified profile (identical verdicts,
# identical rung recovery). A registered Compromise Option -- `compromises_in(config)` detects it
# from the config and banners the report; it forfeits `cheapest_solution_index`, cost-to-exhaust
# and complete `by_primitive`.

config {
    budget.depth_limit: 3
    budget.max_arity: 3
    budget.max_pool: 30
    budget.considered_limit: 2000000
    budget.solution_limit: 1
    budget.solution_limit_mode: 'immediate'
    search_engine.constant_sources: ['finite-enumerate-scalars']
}

floor dae9d2b5-split-L0 {
    use split_h:   (Grid) -> List[Grid]
    use nth:       (List[a], Int) -> a
    use overlay:   (Color, Grid...) -> Grid
    use map_color: (Grid, Color, Color) -> Grid
}

rung {
    west(g: Grid) -> Grid = nth(split_h(g), 0)

    task west-00 {
        solution: west(input)
        train [[4,4,0,3,3,0],[4,0,0,3,0,0],[0,0,0,0,0,3]]
        train [[4,0,0,4,3,0,0,0],[0,4,0,0,0,3,3,0],[4,4,0,0,0,0,0,3],[0,0,4,0,3,0,0,0]]
        test  [[4,0,3,3],[0,4,0,0]]
    }
    task west-01 {
        solution: west(input)
        train [[4,0,0,0,0,0,0,0,0,3],[0,4,0,0,0,0,0,0,3,0],[0,0,4,0,0,0,0,3,0,0],[0,0,0,4,0,0,3,0,0,0],[0,0,0,0,4,3,0,0,0,0]]
        train [[4,0,4,3,0,0],[0,4,0,0,3,3]]
        test  [[4,0,0,3],[0,4,3,0],[4,4,0,0],[0,0,3,3]]
    }
    heldout task west-heldout {
        solution: west(input)
        train [[4,0,0,4,3,3,0,0],[0,4,0,0,0,0,3,0],[4,0,4,0,0,3,0,3]]
        train [[4,0,0,0,3,0],[0,4,0,3,0,3],[0,0,4,0,0,3],[4,0,4,0,3,0],[0,4,0,3,0,0]]
        test  [[4,0,0,4,3,0,3,0],[0,4,4,0,0,3,0,3]]
    }
}

rung {
    east(g: Grid) -> Grid = nth(split_h(g), 1)

    task east-00 {
        solution: east(input)
        train [[4,0,0,3],[0,4,3,0],[4,4,0,0],[0,0,3,3]]
        train [[4,0,0,4,3,3,0,0],[0,4,0,0,0,0,3,0],[4,0,4,0,0,3,0,3]]
        test  [[4,0,0,0,3,0],[0,4,0,3,0,3],[0,0,4,0,0,3],[4,0,4,0,3,0],[0,4,0,3,0,0]]
    }
    task east-01 {
        solution: east(input)
        train [[4,0,0,4,3,0,3,0],[0,4,4,0,0,3,0,3]]
        train [[4,0,0,0,0,3],[0,4,0,0,3,0],[0,0,4,3,0,0],[4,4,4,0,0,0]]
        test  [[4,0,0,3],[0,4,3,0],[4,4,0,0]]
    }
    heldout task east-heldout {
        solution: east(input)
        train [[4,0,0,3],[0,4,3,0],[4,0,0,0],[0,4,3,3],[4,4,3,0]]
        train [[4,0,0,4,0,3,0,0,0,3],[0,4,0,4,0,0,3,0,3,0]]
        test  [[4,0,0,0,4,0,0,0,0,3],[0,4,0,4,0,0,0,3,0,0],[0,0,4,0,0,0,3,0,0,0],[4,4,4,4,0,3,0,0,0,0]]
    }
}

top {
    task dae9d2b5 {
        solution: overlay(0, map_color(west(input), 4, 6), map_color(east(input), 3, 6))
        train [[4,4,0,3,3,0],[4,0,0,3,0,0],[0,0,0,0,0,3]]
        train [[4,0,4,3,3,0],[4,0,0,3,0,0],[0,0,4,3,0,0]]
        train [[0,0,4,0,3,0],[0,4,4,3,0,3],[4,4,0,0,0,3]]
        train [[4,4,0,3,0,0],[0,0,0,0,0,3],[4,0,0,0,0,0]]
        train [[0,0,0,0,3,0],[4,0,0,0,0,0],[0,0,4,3,3,0]]
        test  [[0,4,4,3,0,0],[4,0,0,3,3,0],[0,4,0,3,0,0]]
    }
    heldout task dae9d2b5-heldout {
        solution: overlay(0, map_color(west(input), 4, 6), map_color(east(input), 3, 6))
        train [[0,0,4,0,3,0],[0,4,0,3,3,3],[4,0,0,3,0,0]]
        train [[4,0,0,0,3,0],[0,4,0,3,0,3],[0,0,4,0,0,3],[4,0,4,0,3,0],[0,4,0,3,0,0]]
        test  [[4,4,0,3,3,0],[4,0,0,3,0,0],[0,0,0,0,0,3]]
    }
}
