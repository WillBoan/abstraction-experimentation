ladder al20-recolor-telescope

# ``al20-recolor-telescope``: geometry + colour in a telescope -- the fan-in-1 twin of al19.
#
# Same two rungs as al19 (``pair`` then a recoloured ``pair``), but the top *telescopes* them --
# ``pair`` applied to ``recol`` -- rather than recombining. The pair (al19 fan-in / al20 telescope)
# isolates what the recombination structure alone changes, on identical rungs and floor.
#
# Floor ``{concat_h, translate, map_color}`` -> ``pair`` -> ``recol`` -> top.
#
# - ``r1 = pair``: ``concat_h(g, translate(g, 1, 0))``.
# - ``r2 = recol``: ``map_color(pair, 1, 7)`` (references ``pair``).
# - ``top``: ``pair(recol)`` -- pair the recoloured grid; a pure telescope (fan-in 1).
#
# Recolour is again a *component*, not the whole competence (contrast Family B, al5/al6/al8). Sandwich
# at ``depth_limit=2``; the top is written as the rung call ``pair(recol(input))`` so it is depth 2 over
# L_2 while its inlined double jump exceeds the budget.

config {
    budget.depth_limit: 2
    search_engine.constant_sources: ['finite-enumerate']
}

floor al20-L0 {
    use concat_h:  (Grid, Grid) -> Grid
    use translate: (Grid, Int, Int) -> Grid
    use map_color: (Grid, Color, Color) -> Grid
}

rung {
    pair(g: Grid) -> Grid = concat_h(g, translate(g, 1, 0))

    task pair-00 {
        solution: pair(input)
        train [[4, 2, 4], [2, 4, 2]]
        train [[1, 4, 3], [2, 1, 4]]
        test  [[2, 3, 4], [1, 2, 3]]
    }
    task pair-01 {
        solution: pair(input)
        train [[3, 2, 1], [4, 3, 2]]
        train [[4, 1, 2], [3, 4, 1]]
        test  [[1, 3, 1], [3, 1, 3]]
    }
    heldout task pair-heldout-00 {
        solution: pair(input)
        train [[2, 3, 4], [1, 2, 3]]
        train [[3, 1, 3], [1, 3, 1]]
        test  [[4, 3, 2], [1, 4, 3]]
    }
}

rung {
    recol(g: Grid) -> Grid = map_color(pair(g), 1, 7)

    task recol-00 {
        solution: recol(input)
        train [[1, 3, 1], [3, 1, 3]]
        train [[2, 1, 4], [3, 2, 1]]
        test  [[3, 4, 1], [2, 3, 4]]
    }
    task recol-01 {
        solution: recol(input)
        train [[4, 3, 2], [1, 4, 3]]
        train [[1, 2, 3], [4, 1, 2]]
        test  [[2, 4, 2], [4, 2, 4]]
    }
    heldout task recol-heldout-00 {
        solution: recol(input)
        train [[3, 4, 1], [2, 3, 4]]
        train [[4, 2, 4], [2, 4, 2]]
        test  [[1, 4, 3], [2, 1, 4]]
    }
}

top {
    task top-00 {
        solution: pair(recol(input))
        train [[2, 4, 2], [4, 2, 4]]
        train [[3, 2, 1], [4, 3, 2]]
        test  [[4, 1, 2], [3, 4, 1]]
    }
    heldout task top-heldout-00 {
        solution: pair(recol(input))
        train [[1, 4, 3], [2, 1, 4]]
        train [[2, 3, 4], [1, 2, 3]]
        test  [[3, 1, 3], [1, 3, 1]]
    }
}
