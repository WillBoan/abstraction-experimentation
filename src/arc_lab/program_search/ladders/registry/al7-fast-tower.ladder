ladder al7-fast-tower

# ``al7-fast-tower``: height 6 with every jump at depth 2 -- the tall-AND-cheap ladder.
#
# The batch had no ladder that was both tall and quick, so "does the loop climb six rungs?" could not
# be iterated on. This fixes that. The trick is that al3's Floor costs 973k candidates at
# ``depth_limit=4`` but only **61** at ``depth_limit=2`` -- so a tower whose every jump is depth 2
# runs on the same layout floor for a rounding error.
#
# Each rung doubles one dimension by stacking the rung below against itself, alternating axes. From a
# 2x3 seed the widths/heights run 2x6 -> 4x6 -> 4x12 -> 8x12 -> 8x24 -> 16x24, inside the ARC 30 cap.
# Grid growth is what keeps the tower non-collapsing (a size-preserving tower on a finite grid must
# eventually cycle) -- and it is also what caps height at roughly 6.
#
# **KNOWN BROKEN -- the concept telescopes, structurally (2026-07-20).** The certificate found skip
# paths at rungs 3, 4, 5: ``stack2(stack2 g) == tall4 g``, ``stack2(wide4 g) == wide8 g``, etc. The
# cause is not the choice of transform -- ANY self-similar doubling satisfies ``r_{2k} == r2^k``, so
# every even rung is a depth-2 composition of the rung two below. Verified transform-independent: a
# plain-``concat``-only tower (asymmetric seed, no flips) collapses identically (``r4 == r2(r2 g))``).
# The Floor ``{concat_h, concat_v, flip_h, flip_v}`` can only express doublings and mirrorings, and
# those all telescope, so no seeding or reordering fixes it -- a genuinely non-collapsing tall+cheap
# tower needs distinct, non-composing rung operations (hence a richer Floor), which is a redesign, not
# a tweak. ``al9-decoy`` and ``al11-greedy-trap`` build on this spine and inherit the defect. Left in
# the registry pending that redesign; do not expect ``admitted``.

config {
    budget.depth_limit: 2
    learn.iterations: 8
}

floor al7-L0 {
    use concat_h: (Grid, Grid) -> Grid
    use concat_v: (Grid, Grid) -> Grid
    use flip_h:   (Grid) -> Grid
    use flip_v:   (Grid) -> Grid
}

rung {
    mirror(g: Grid) -> Grid = concat_h(g, flip_h(g))

    task mirror-00 {
        solution: mirror(input)
        train [[4, 1, 3], [5, 2, 4]]
        train [[4, 2, 5], [3, 1, 4]]
        test  [[4, 3, 2], [1, 5, 4]]
    }
    task mirror-01 {
        solution: mirror(input)
        train [[2, 5, 3], [1, 4, 2]]
        train [[2, 1, 5], [4, 3, 2]]
        test  [[2, 3, 4], [5, 1, 2]]
    }
    heldout task mirror-heldout-00 {
        solution: mirror(input)
        train [[5, 4, 3], [2, 1, 5]]
        train [[5, 1, 2], [3, 4, 5]]
        test  [[5, 2, 4], [1, 3, 5]]
    }
}

rung {
    stack2(g: Grid) -> Grid = concat_v(mirror(g), mirror(g))

    task stack2-00 {
        solution: stack2(input)
        train [[3, 4, 5], [1, 2, 3]]
        train [[3, 5, 2], [4, 1, 3]]
        test  [[3, 1, 4], [2, 5, 3]]
    }
    task stack2-01 {
        solution: stack2(input)
        train [[1, 3, 5], [2, 4, 1]]
        train [[1, 4, 2], [5, 3, 1]]
        test  [[1, 5, 4], [3, 2, 1]]
    }
    heldout task stack2-heldout-00 {
        solution: stack2(input)
        train [[4, 2, 5], [3, 1, 4]]
        train [[4, 3, 2], [1, 5, 4]]
        test  [[4, 5, 1], [2, 3, 4]]
    }
}

rung {
    wide4(g: Grid) -> Grid = concat_h(stack2(g), stack2(g))

    task wide4-00 {
        solution: wide4(input)
        train [[2, 1, 5], [4, 3, 2]]
        train [[2, 3, 4], [5, 1, 2]]
        test  [[2, 4, 1], [3, 5, 2]]
    }
    task wide4-01 {
        solution: wide4(input)
        train [[5, 1, 2], [3, 4, 5]]
        train [[5, 2, 4], [1, 3, 5]]
        test  [[5, 3, 1], [4, 2, 5]]
    }
    heldout task wide4-heldout-00 {
        solution: wide4(input)
        train [[3, 5, 2], [4, 1, 3]]
        train [[3, 1, 4], [2, 5, 3]]
        test  [[3, 2, 1], [5, 4, 3]]
    }
}

rung {
    tall4(g: Grid) -> Grid = concat_v(wide4(g), wide4(g))

    task tall4-00 {
        solution: tall4(input)
        train [[1, 4, 2], [5, 3, 1]]
        train [[1, 5, 4], [3, 2, 1]]
        test  [[1, 2, 3], [4, 5, 1]]
    }
    task tall4-01 {
        solution: tall4(input)
        train [[4, 3, 2], [1, 5, 4]]
        train [[4, 5, 1], [2, 3, 4]]
        test  [[4, 1, 3], [5, 2, 4]]
    }
    heldout task tall4-heldout-00 {
        solution: tall4(input)
        train [[2, 3, 4], [5, 1, 2]]
        train [[2, 4, 1], [3, 5, 2]]
        test  [[2, 5, 3], [1, 4, 2]]
    }
}

rung {
    wide8(g: Grid) -> Grid = concat_h(tall4(g), tall4(g))

    task wide8-00 {
        solution: wide8(input)
        train [[5, 2, 4], [1, 3, 5]]
        train [[5, 3, 1], [4, 2, 5]]
        test  [[5, 4, 3], [2, 1, 5]]
    }
    task wide8-01 {
        solution: wide8(input)
        train [[3, 1, 4], [2, 5, 3]]
        train [[3, 2, 1], [5, 4, 3]]
        test  [[3, 4, 5], [1, 2, 3]]
    }
    heldout task wide8-heldout-00 {
        solution: wide8(input)
        train [[1, 5, 4], [3, 2, 1]]
        train [[1, 2, 3], [4, 5, 1]]
        test  [[1, 3, 5], [2, 4, 1]]
    }
}

top {
    task top-00 {
        solution: concat_v(wide8(input), wide8(input))
        train [[4, 5, 1], [2, 3, 4]]
        train [[4, 1, 3], [5, 2, 4]]
        test  [[4, 2, 5], [3, 1, 4]]
    }
    heldout task top-heldout-00 {
        solution: concat_v(wide8(input), wide8(input))
        train [[2, 4, 1], [3, 5, 2]]
        train [[2, 5, 3], [1, 4, 2]]
        test  [[2, 1, 5], [4, 3, 2]]
    }
}
