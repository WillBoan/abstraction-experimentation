ladder al6-mirror-tall

# ``al6-mirror-tall``: the tallest ladder in the batch -- height 5, jumps [2,3,3,3].
#
# Same floor as :mod:`al5_perceiver` plus nothing: al5 is height 4, al6 is height 5, so the pair is
# the batch's **height axis** with the floor held constant. r1 is AL1's own ``rot180``, so this is a
# genuine upward extension of ladder #1 rather than a separate design -- AL1 becomes its shallow
# control.
#
# Note r1 is d=2 while every rung above is d=3. That is fine, and the reason is worth recording: the
# double-jump check is about **call-site nesting**, not depth uniformity. Skipping ``r_i`` is forbidden
# iff ``(nesting of the r_i call site inside r_{i+1}) + d_i > depth_limit``; ``norm_mirror`` calls
# ``rot180`` at nesting 2, so 2 + 2 = 4 > 3 and the rung is unskippable despite being shallow. An
# earlier draft called it at nesting 1 (3, not > 3) and the rung was free to skip.

config {
    budget.depth_limit: 3
    budget.max_arity: 3
    budget.max_pool: 1500
    search_engine.constant_sources: ['finite-enumerate']
    learn.iterations: 7
}

floor al6-L0 {
    use flip_h:             (Grid) -> Grid
    use flip_v:             (Grid) -> Grid
    use map_color:          (Grid, Color, Color) -> Grid
    use most_common_color:  (Grid) -> Color
    use least_common_color: (Grid) -> Color
}

rung {
    rot180(g: Grid) -> Grid = flip_h(flip_v(g))

    task rot180-00 {
        solution: rot180(input)
        train [[4, 2, 4], [2, 4, 2]]
        train [[1, 4, 3], [2, 1, 4]]
        test  [[2, 3, 4], [1, 2, 3]]
    }
    task rot180-01 {
        solution: rot180(input)
        train [[3, 2, 1], [4, 3, 2]]
        train [[4, 1, 2], [3, 4, 1]]
        test  [[1, 3, 1], [3, 1, 3]]
    }
    heldout task rot180-heldout-00 {
        solution: rot180(input)
        train [[2, 3, 4], [1, 2, 3]]
        train [[3, 1, 3], [1, 3, 1]]
        test  [[4, 3, 2], [1, 4, 3]]
    }
}

rung {
    norm_mirror(g: Grid, c: Color) -> Grid = map_color(flip_h(rot180(g)), most_common_color(g), c)

    task norm_mirror-00 {
        solution: norm_mirror(input, 3)
        train [[1, 3, 1], [3, 1, 3]]
        train [[2, 1, 4], [3, 2, 1]]
        test  [[3, 4, 1], [2, 3, 4]]
    }
    task norm_mirror-01 {
        solution: norm_mirror(input, 7)
        train [[4, 3, 2], [1, 4, 3]]
        train [[1, 2, 3], [4, 1, 2]]
        test  [[2, 4, 2], [4, 2, 4]]
    }
    heldout task norm_mirror-heldout-00 {
        solution: norm_mirror(input, 5)
        train [[3, 4, 1], [2, 3, 4]]
        train [[4, 2, 4], [2, 4, 2]]
        test  [[1, 4, 3], [2, 1, 4]]
    }
}

rung {
    norm_stack(g: Grid, c: Color, c2: Color) -> Grid = map_color(flip_v(norm_mirror(g, c)), least_common_color(flip_h(g)), c2)

    task norm_stack-00 {
        solution: norm_stack(input, 3, 8)
        train [[2, 4, 2], [4, 2, 4]]
        train [[3, 2, 1], [4, 3, 2]]
        test  [[4, 1, 2], [3, 4, 1]]
    }
    task norm_stack-01 {
        solution: norm_stack(input, 7, 9)
        train [[1, 4, 3], [2, 1, 4]]
        train [[2, 3, 4], [1, 2, 3]]
        test  [[3, 1, 3], [1, 3, 1]]
    }
    heldout task norm_stack-heldout-00 {
        solution: norm_stack(input, 5, 6)
        train [[4, 1, 2], [3, 4, 1]]
        train [[1, 3, 1], [3, 1, 3]]
        test  [[2, 1, 4], [3, 2, 1]]
    }
}

rung {
    norm_quad(g: Grid, c: Color, c2: Color, c3: Color) -> Grid = map_color(flip_h(norm_stack(g, c, c2)), most_common_color(flip_v(g)), c3)

    task norm_quad-00 {
        solution: norm_quad(input, 3, 8, 2)
        train [[3, 1, 3], [1, 3, 1]]
        train [[4, 3, 2], [1, 4, 3]]
        test  [[1, 2, 3], [4, 1, 2]]
    }
    task norm_quad-01 {
        solution: norm_quad(input, 7, 9, 6)
        train [[2, 1, 4], [3, 2, 1]]
        train [[3, 4, 1], [2, 3, 4]]
        test  [[4, 2, 4], [2, 4, 2]]
    }
    heldout task norm_quad-heldout-00 {
        solution: norm_quad(input, 5, 6, 0)
        train [[1, 2, 3], [4, 1, 2]]
        train [[2, 4, 2], [4, 2, 4]]
        test  [[3, 2, 1], [4, 3, 2]]
    }
}

top {
    task top-00 {
        solution: flip_v(norm_quad(input, 1, 7, 4))
        train [[4, 2, 4], [2, 4, 2]]
        train [[1, 4, 3], [2, 1, 4]]
        test  [[2, 3, 4], [1, 2, 3]]
    }
    heldout task top-heldout-00 {
        solution: flip_v(norm_quad(input, 1, 7, 4))
        train [[3, 2, 1], [4, 3, 2]]
        train [[4, 1, 2], [3, 4, 1]]
        test  [[1, 3, 1], [3, 1, 3]]
    }
}
