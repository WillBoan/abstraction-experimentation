ladder al8-lean-perceiver

# ``al8-lean-perceiver``: al5's competence with **zero free parameters** and no constant sources.
#
# al5 measured that enumerated COLOR constants dominate its cost (63% of candidates were deduplicated
# duplicates, and AL1 decomposed its b_eff almost entirely into ``map_color``'s two enumerated colour
# arguments contributing x100 per application). This ladder tests that directly: the same
# perceive-and-recolour competence, the same floor, the same depths -- but every colour argument is
# *derived* from a perceiver instead of being a free parameter, so ``constant_sources`` is empty and
# round 0 holds a single leaf instead of eleven.
#
# If it runs in seconds where al5 takes an hour, that quantifies where the cost actually lives, and
# gives the batch a fast perceiver ladder to iterate on.
#
# **Not an admittable ladder -- a cost-comparison ARM to al5 (2026-07-20).** The empirical certificate
# rejects it, correctly: deriving the colours cheaply is exactly what removes the search-cost gap that
# makes al5 a ladder. With perceived (not enumerated) colours, the whole competence is one depth-2
# Floor program -- the certificate found L_0 solving the top directly via
# ``map_color(flip_v(input), least_common_color(input), most_common_color(input))``. So there is
# nothing to climb and no amortization to measure; the value here is the head-to-head *cost* against
# al5 at matched competence, read from the iteration-0 wake (``considered``, ``b_eff``, the per-primitive
# partition), NOT from admission. Kept in the registry as that arm, like the ``al9``--``al12`` controls;
# do not expect ``admitted``.

config {
    budget.depth_limit: 3
    budget.max_arity: 3
    budget.max_pool: 1500
    learn.iterations: 6
}

floor al8-L0 {
    use map_color:          (Grid, Color, Color) -> Grid
    use most_common_color:  (Grid) -> Color
    use least_common_color: (Grid) -> Color
    use flip_h:             (Grid) -> Grid
    use flip_v:             (Grid) -> Grid
}

rung {
    swap_ext(g: Grid) -> Grid = map_color(map_color(g, most_common_color(g), least_common_color(g)), least_common_color(g), most_common_color(g))

    task swap_ext-00 {
        solution: swap_ext(input)
        train [[4, 2, 4], [2, 4, 2]]
        train [[1, 4, 3], [2, 1, 4]]
        test  [[2, 3, 4], [1, 2, 3]]
    }
    task swap_ext-01 {
        solution: swap_ext(input)
        train [[3, 2, 1], [4, 3, 2]]
        train [[4, 1, 2], [3, 4, 1]]
        test  [[1, 3, 1], [3, 1, 3]]
    }
    heldout task swap_ext-heldout-00 {
        solution: swap_ext(input)
        train [[2, 3, 4], [1, 2, 3]]
        train [[3, 1, 3], [1, 3, 1]]
        test  [[4, 3, 2], [1, 4, 3]]
    }
}

rung {
    swap_mir(g: Grid) -> Grid = map_color(flip_h(swap_ext(g)), most_common_color(g), least_common_color(g))

    task swap_mir-00 {
        solution: swap_mir(input)
        train [[1, 3, 1], [3, 1, 3]]
        train [[2, 1, 4], [3, 2, 1]]
        test  [[3, 4, 1], [2, 3, 4]]
    }
    task swap_mir-01 {
        solution: swap_mir(input)
        train [[4, 3, 2], [1, 4, 3]]
        train [[1, 2, 3], [4, 1, 2]]
        test  [[2, 4, 2], [4, 2, 4]]
    }
    heldout task swap_mir-heldout-00 {
        solution: swap_mir(input)
        train [[3, 4, 1], [2, 3, 4]]
        train [[4, 2, 4], [2, 4, 2]]
        test  [[1, 4, 3], [2, 1, 4]]
    }
}

rung {
    swap_stk(g: Grid) -> Grid = map_color(flip_v(swap_mir(g)), least_common_color(flip_h(g)), most_common_color(flip_v(g)))

    task swap_stk-00 {
        solution: swap_stk(input)
        train [[2, 4, 2], [4, 2, 4]]
        train [[3, 2, 1], [4, 3, 2]]
        test  [[4, 1, 2], [3, 4, 1]]
    }
    task swap_stk-01 {
        solution: swap_stk(input)
        train [[1, 4, 3], [2, 1, 4]]
        train [[2, 3, 4], [1, 2, 3]]
        test  [[3, 1, 3], [1, 3, 1]]
    }
    heldout task swap_stk-heldout-00 {
        solution: swap_stk(input)
        train [[4, 1, 2], [3, 4, 1]]
        train [[1, 3, 1], [3, 1, 3]]
        test  [[2, 1, 4], [3, 2, 1]]
    }
}

top {
    task top-00 {
        solution: flip_h(swap_stk(input))
        train [[3, 1, 3], [1, 3, 1]]
        train [[4, 3, 2], [1, 4, 3]]
        test  [[1, 2, 3], [4, 1, 2]]
    }
    heldout task top-heldout-00 {
        solution: flip_h(swap_stk(input))
        train [[2, 1, 4], [3, 2, 1]]
        train [[3, 4, 1], [2, 3, 4]]
        test  [[4, 2, 4], [2, 4, 2]]
    }
}
