ladder al19-fanin-recolor

# ``al19-fanin-recolor``: fan-in > 1 where the recombined rungs differ by *colour*, not geometry.
#
# The colour sibling of al18: instead of stacking ``pair`` against its rotation, it stacks ``pair``
# against a *recoloured* ``pair`` -- so the fan-in recombines a geometric rung with a colour-remapped
# one. Shares ``r1``/``r2`` with al20 but recombines them (``concat_v(pair, recol)``) instead of
# telescoping, which makes the two a clean fan-in-vs-telescope contrast on identical rungs.
#
# Floor ``{concat_h, concat_v, translate, map_color}`` -> ``pair`` -> ``recol`` -> top.
#
# - ``r1 = pair``: ``concat_h(g, translate(g, (1, 0)))``.
# - ``r2 = recol``: ``map_color(pair, 1, 7)`` (references ``pair``; shape-preserving, so it recombines).
# - ``top``: ``concat_v(pair, recol)`` -- **fan-in 2**.
#
# ``map_color`` appears as one *component*, never the whole competence -- the Family-B collapse (al5/
# al6/al8) was recolour-*only* ladders, which have no compositional depth; here the geometry carries
# the depth and the recolour is a sibling rung. Sandwich at ``depth_limit=2``.

config {
    budget.depth_limit: 2
    search_engine.constant_sources: ['finite-enumerate']
}

floor al19-L0 {
    use concat_h:  (Grid, Grid) -> Grid
    use concat_v:  (Grid, Grid) -> Grid
    use translate: (Grid, Offset) -> Grid
    use map_color: (Grid, Color, Color) -> Grid
}

rung {
    pair(g: Grid) -> Grid = concat_h(g, translate(g, (1, 0)))

    task pair-00 {
        solution: pair(input)
        train [[4, 2, 4], [2, 4, 2]]
        train [[1, 4, 3], [2, 1, 4]]
        test  [[2, 3, 4], [1, 2, 3]]
    }
    task pair-01 {
        solution: pair(input)
        train [[3, 2, 1], [4, 3, 2]]
        train [[4, 1, 2], [3, 4, 1]]
        test  [[1, 3, 1], [3, 1, 3]]
    }
    heldout task pair-heldout-00 {
        solution: pair(input)
        train [[2, 3, 4], [1, 2, 3]]
        train [[3, 1, 3], [1, 3, 1]]
        test  [[4, 3, 2], [1, 4, 3]]
    }
}

rung {
    recol(g: Grid) -> Grid = map_color(pair(g), 1, 7)

    task recol-00 {
        solution: recol(input)
        train [[1, 3, 1], [3, 1, 3]]
        train [[2, 1, 4], [3, 2, 1]]
        test  [[3, 4, 1], [2, 3, 4]]
    }
    task recol-01 {
        solution: recol(input)
        train [[4, 3, 2], [1, 4, 3]]
        train [[1, 2, 3], [4, 1, 2]]
        test  [[2, 4, 2], [4, 2, 4]]
    }
    heldout task recol-heldout-00 {
        solution: recol(input)
        train [[3, 4, 1], [2, 3, 4]]
        train [[4, 2, 4], [2, 4, 2]]
        test  [[1, 4, 3], [2, 1, 4]]
    }
}

top {
    task top-00 {
        solution: concat_v(pair(input), recol(input))
        train [[2, 4, 2], [4, 2, 4]]
        train [[3, 2, 1], [4, 3, 2]]
        test  [[4, 1, 2], [3, 4, 1]]
    }
    heldout task top-heldout-00 {
        solution: concat_v(pair(input), recol(input))
        train [[1, 4, 3], [2, 1, 4]]
        train [[2, 3, 4], [1, 2, 3]]
        test  [[3, 1, 3], [1, 3, 1]]
    }
}
