al1-mirror (intended rungs: ['rot180', 'mirror_recolor'])
  abs0 arity=1: flip_h(flip_v(#0))
  abs1 arity=3: map_color(abs0(#0), #1, #2)
  abs2 arity=1: map_color(#0, 3, 4)
al17-shift-frame-tall (intended rungs: ['shift1', 'frame1', 'shift2'])
  abs0 arity=1: concat_v(#0, translate(#0, 0, 1))
  abs1 arity=1: pad(abs0(#0), 1, 5)
  abs2 arity=1: abs0(abs1(#0))
  abs3 arity=2: pad(#0, 1, #1)
  abs4 arity=1: abs3(abs0(#0), 5)
